    {
      "name": "5. Procurement Service",
      "item": [
        {
          "name": "Get All Purchase Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response.length > 0) {",
                  "  pm.collectionVariables.set('purchase_order_id', response[0].id);",
                  "  console.log('Purchase Order ID saved:', response[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}:8081/api/purchase-orders",
              "host": [
                "{{base_url}}"
              ],
              "port": "8081",
              "path": [
                "api",
                "purchase-orders"
              ]
            },
            "description": "Returns all purchase orders sorted by createdAt DESC. Auto-created orders from LOW_STOCK Kafka events appear here with status CREATED."
          },
          "response": []
        },
        {
          "name": "Approve Purchase Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}:8081/api/purchase-orders/{{purchase_order_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "port": "8081",
              "path": [
                "api",
                "purchase-orders",
                "{{purchase_order_id}}",
                "approve"
              ]
            },
            "description": "Transitions Purchase Order from CREATED → APPROVED. Only ADMIN role can approve."
          },
          "response": []
        },
        {
          "name": "Receive Purchase Order (Replenishes Stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}:8081/api/purchase-orders/{{purchase_order_id}}/receive",
              "host": [
                "{{base_url}}"
              ],
              "port": "8081",
              "path": [
                "api",
                "purchase-orders",
                "{{purchase_order_id}}",
                "receive"
              ]
            },
            "description": "Transitions APPROVED → RECEIVED and publishes RECEIVE_GOODS event to Kafka. Inventory-service consumes it and increases stock automatically — completing the full replenishment cycle."
          },
          "response": []
        },
        {
          "name": "Health Check - Procurement Service",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}:8081/actuator/health",
              "host": [
                "{{base_url}}"
              ],
              "port": "8081",
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Returns DB + Kafka connectivity status. No JWT required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Role-Based Access Control (Demo)",
      "item": [
