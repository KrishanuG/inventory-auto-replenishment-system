              ],
              "port": "8080",
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Login as USER first, then run this. Should return 200."
          },
          "response": []
        },
        {
          "name": "USER role - Increase Stock (forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}:8080/api/inventory/{{product_id}}/stock/increase?quantity=10",
              "host": [
                "{{base_url}}"
              ],
              "port": "8080",
              "path": [
                "api",
                "inventory",
                "{{product_id}}",
                "stock",
                "increase"
              ],
              "query": [
                {
                  "key": "quantity",
                  "value": "10"
                }
              ]
            },
            "description": "Login as USER first, then run this. Should return 403 Forbidden — only ADMIN can modify stock."
          },
          "response": []
        }
      ]
    }
