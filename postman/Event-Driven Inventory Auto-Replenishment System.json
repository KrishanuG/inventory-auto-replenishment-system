                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}:8080/api/analytics/stock-outs",
              "host": [
                "{{base_url}}"
              ],
              "port": "8080",
              "path": [
                "api",
